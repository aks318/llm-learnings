```gitignore
# ==========================================
# Python cache files
# ==========================================
__pycache__/
*.py[cod]
*$py.class

# Python build and distribution
build/
dist/
*.egg-info/
.eggs/
wheels/
pip-wheel-metadata/

# ==========================================
# Virtual environments
# ==========================================
.venv/
venv/
env/
ENV/

# ==========================================
# Python testing and coverage
# ==========================================
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/

# ==========================================
# Type checkers and linters
# ==========================================
.mypy_cache/
.pyright/
.ruff_cache/
.dmypy.json
.pyre/

# ==========================================
# Jupyter Notebook
# ==========================================
.ipynb_checkpoints/

# ==========================================
# Environment variables and secrets
# ==========================================
.env
.env.*
!.env.example
!.env.sample

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx

# ==========================================
# Logs and temporary files
# ==========================================
*.log
logs/
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo
*~

# ==========================================
# IDE and editor settings
# ==========================================
.vscode/
.idea/
*.code-workspace

# ==========================================
# OS-generated files
# ==========================================
.DS_Store
Thumbs.db
desktop.ini

# ==========================================
# Node.js / React / Next.js
# ==========================================
node_modules/
.next/
out/
dist/
coverage/
.npm/
.turbo/

# ==========================================
# AI models and large model files
# ==========================================
*.gguf
*.safetensors
*.ggml
*.pt
*.pth
*.onnx
*.bin
*.model

# Model and checkpoint directories
models/
checkpoints/
weights/

# ==========================================
# Datasets and downloaded documents
# ==========================================
datasets/
data/raw/
data/external/
*.parquet
*.arrow

# ==========================================
# Local databases and vector stores
# ==========================================
*.sqlite
*.sqlite3
*.db
chroma_db/
.qdrant/
vector_store/

# ==========================================
# Local application state
# ==========================================
instance/
.streamlit/secrets.toml

# ==========================================
# OS and package-manager artifacts
# ==========================================
*.deb
*.rpm
```

